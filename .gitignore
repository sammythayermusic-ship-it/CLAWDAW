# macOS
.DS_Store

# Build outputs
build/
DerivedData/
*.xcuserdata*
*.xcodeproj/xcuserdata/
*.xcworkspace/xcuserdata/

# Editor / IDE
.vscode/
.idea/
*.swp

# Claude Code agent state — worktrees, session caches.
.claude/

# Vendored Tracktion Engine + JUCE source. Currently extracted from tarballs;
# will become git submodules when network cooperates. Setup steps live in
# docs/session-log.md.
engine/third_party/

# Generated proto/gRPC code. Engine (C++) and UI (TS) regenerate with
# `cd proto && buf generate`. Python regenerates locally via
# `agent/scripts/regen-proto.sh` (uses the venv's grpc_tools.protoc so
# the gencode version matches the runtime — see that script for context).
engine/generated/
agent/generated/
ui/src/generated/

# Python tooling — the venv is per-machine; uv.lock is committed.
agent/.venv/
__pycache__/
*.egg-info/
.pytest_cache/
.ruff_cache/
